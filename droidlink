#!/usr/bin/env bash
# droidlink: 맥북 키보드/트랙패드를 안드로이드에 실제 키보드·마우스(UHID)로 연결한다.
# 터미널용 실행기 — droidlink.app을 만들어(처음 한 번) 그 안의 앱을 터미널에서 띄운다.
set -euo pipefail

usage() {
  cat <<USAGE
사용법:
  droidlink                     droidlink 창을 띄우고 연결 (USB 우선, 없으면 무선)
  droidlink IP:PORT             이 주소로 무선 연결
  droidlink pair IP:PORT CODE   무선 디버깅 페어링 (안드로이드 11+, 최초 1회)

맥 화면 끝으로 커서를 밀면 키보드·마우스가 폰으로 넘어가고, 폰 화면 반대쪽 끝으로 밀면 맥으로 돌아온다.
폰 위치(왼쪽/오른쪽), 커서·스크롤 속도, 무선·블루투스 연결은 droidlink 창에서 바꾼다. 막히면 Cmd+Option+Esc.
USAGE
}

dir=$(dirname "$(readlink -f "$0")")
app="$dir/droidlink.app/Contents/MacOS/droidlink"
adb="$dir/droidlink.app/Contents/Resources/scrcpy/adb"

case "${1:-}" in -h|--help) usage; exit 0 ;; esac
# 소스가 앱보다 새로우면 다시 만든다
[ -x "$app" ] && [ "$app" -nt "$dir/edge.swift" ] || "$dir/build-app.sh" >/dev/null

case "${1:-}" in
  pair)
    [ $# -eq 3 ] || { usage >&2; exit 1; }
    exec "$adb" pair "$2" "$3" ;;
  "") ;;
  *)
    "$adb" connect "$1"
    export ANDROID_SERIAL="$1" ;;
esac

exec "$app"
